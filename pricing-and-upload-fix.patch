+.save { padding: 3px 8px; border-radius: 999px; background: #d1fadf; color: #067647; font-size: 11px; font-weight: 800; }
+.segmentOn .save { background: rgba(255, 255, 255, 0.22); color: #fff; }
+
+.plans { display: grid; gap: 18px; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); align-items: stretch; }
+.plan, .planPopular {
+  position: relative;
