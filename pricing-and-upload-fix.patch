+  text-transform: uppercase;
+}
+.tagline { min-height: 42px; margin: 6px 0 16px; color: var(--color-muted); font-size: 14px; line-height: 1.5; }
+.price { display: flex; align-items: baseline; gap: 4px; margin: 0; strong { font-size: 2rem; letter-spacing: -0.045em; } span { color: var(--color-muted); font-size: 14px; } }
+.priceSub { min-height: 36px; margin: 4px 0 18px; color: var(--color-muted); font-size: 12.5px; line-height: 1.5; }
+.cta, .ctaPrimary {
+  display: inline-flex;
+  min-height: 48px;
+  align-items: center;
+  justify-content: center;
+  border-radius: 12px;
+  font-size: 15px;
+  font-weight: 750;
+  text-decoration: none;
+}
+.cta { border: 1px solid #c8cfdd; background: var(--color-surface); color: var(--color-text); &:hover { border-color: var(--color-primary); color: var(--color-primary); } }
+.ctaPrimary { background: var(--color-primary); color: #fff; box-shadow: 0 10px 26px rgb(49 87 213 / 28%); &:hover { background: #2446b8; } }
+
+.compare {
+  margin-top: 44px;
+  h2 { margin: 0 0 16px; font-size: clamp(1.4rem, 4vw, 1.9rem); letter-spacing: -0.04em; }
+}
+.tableWrap {
+  overflow-x: auto;
+  border: 1px solid var(--color-border);
+  border-radius: 18px;
+  background: var(--color-surface);
+
+  /* Element selectors live under .tableWrap: CSS Modules requires every selector to contain a local class. */
+  table { width: 100%; min-width: 640px; border-collapse: collapse; font-size: 14px; }
+  th, td { padding: 14px 16px; border-bottom: 1px solid #eef0f4; text-align: center; vertical-align: middle; }
+  thead th { background: #f9fafb; color: var(--color-text); font-size: 14px; font-weight: 800; }
+  tbody th { position: sticky; left: 0; z-index: 1; min-width: 210px; background: var(--color-surface); font-weight: 600; text-align: left; }
+  tbody tr:last-child th, tbody tr:last-child td { border-bottom: 0; }
+  .popularCol { background: #f5f8ff; }
+
+  /* Phones: keep all plan columns on screen instead of pushing them off to the right. */
+  @media (max-width: 560px) {
+    table { min-width: 0; font-size: 12.5px; }
+    th, td { padding: 11px 6px; }
+    thead th { font-size: 12.5px; }
+    tbody th { min-width: 0; width: 38%; padding-left: 12px; line-height: 1.35; }
+  }
+}
+.yes { color: #12b76a; }
+.no { color: #c5cad6; }
+.soon { margin-left: 8px; padding: 2px 7px; border-radius: 999px; background: #eef2ff; color: var(--color-primary); font-size: 10.5px; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; }
+.srOnly { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
+
+.footer { margin-top: auto; padding-top: 34px; color: var(--color-muted); font-size: 13px; text-align: center; p { margin: 0 0 10px; } a { color: var(--color-primary); font-weight: 700; text-decoration: none; } }
