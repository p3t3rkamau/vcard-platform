generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum CardStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContactMethodType {
  PHONE
  EMAIL
  WHATSAPP
  WEBSITE
  ADDRESS
  OTHER
}

enum MediaType {
  PROFILE_IMAGE
  COVER_IMAGE
  COMPANY_LOGO
  PORTFOLIO_IMAGE
  OTHER
}

enum AnalyticsEventType {
  PROFILE_VIEW
  QR_SCAN
  CONTACT_SAVE
  WEBSITE_CLICK
  SOCIAL_CLICK
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts               Account[]
  sessions               Session[]
  ownedCards             BusinessCard[]       @relation("CardOwner")
  organizationMemberships OrganizationMember[]
  createdOrganizations   Organization[]       @relation("OrganizationCreator")
  media                  Media[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  website     String?
  logoUrl     String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User                 @relation("OrganizationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members   OrganizationMember[]
  cards     BusinessCard[]
  media     Media[]

  @@index([createdById])
  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(VIEWER)
  joinedAt       DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Template {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?  @db.Text
  category      String?
  previewImage  String?
  configuration Json?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cards BusinessCard[]

  @@index([isActive, sortOrder])
  @@map("templates")
}

model BusinessCard {
  id             String     @id @default(cuid())
  publicId       String     @unique @default(uuid())
  slug           String     @unique
  ownerId        String
  organizationId String?
  templateId     String?
  status         CardStatus @default(DRAFT)

  firstName       String?
  lastName        String?
  displayName     String?
  jobTitle        String?
  companyName     String?
  bio             String?   @db.Text
  profileImageUrl String?
  coverImageUrl   String?
  companyLogoUrl  String?
  website         String?
  address         String?
  city            String?
  region          String?
  country         String?
  workingHours    Json?

  isSearchable Boolean  @default(true)
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  owner          User             @relation("CardOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  template       Template?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  contactMethods ContactMethod[]
  socialLinks    SocialLink[]
  qrDesign       QRDesign?
  media          Media[]
  analytics      AnalyticsEvent[]
  slugRedirects  SlugRedirect[]

  @@index([ownerId, status])
  @@index([organizationId, status])
  @@index([templateId])
  @@index([status, isSearchable])
  @@index([deletedAt])
  @@map("business_cards")
}

model ContactMethod {
  id             String            @id @default(cuid())
  businessCardId String
  type           ContactMethodType
  label          String?
  value          String
  isPrimary      Boolean           @default(false)
  isVisible      Boolean           @default(true)
  sortOrder      Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  businessCard BusinessCard @relation(fields: [businessCardId], references: [id], onDelete: Cascade)

  @@index([businessCardId, sortOrder])
  @@map("contact_methods")
}

model SocialLink {
  id             String   @id @default(cuid())
  businessCardId String
  platform       String
  label          String?
  url            String
  isVisible      Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  businessCard BusinessCard @relation(fields: [businessCardId], references: [id], onDelete: Cascade)

  @@index([businessCardId, sortOrder])
  @@map("social_links")
}

model QRDesign {
  id                   String   @id @default(cuid())
  businessCardId       String   @unique
  foregroundColor      String   @default("#111827")
  backgroundColor      String   @default("#FFFFFF")
  dotsType             String   @default("rounded")
  cornersSquareType    String   @default("extra-rounded")
  cornersDotType       String   @default("dot")
  errorCorrectionLevel String   @default("H")
  frameStyle           String?
  frameText            String?
  logoUrl              String?
  updatedAt            DateTime @updatedAt

  businessCard BusinessCard @relation(fields: [businessCardId], references: [id], onDelete: Cascade)

  @@map("qr_designs")
}

model Media {
  id             String    @id @default(cuid())
  ownerId        String
  organizationId String?
  businessCardId String?
  type           MediaType @default(OTHER)
  publicUrl      String
  blobPath       String    @unique
  fileName       String
  mimeType       String
  sizeBytes      Int
  width          Int?
  height         Int?
  altText        String?
  createdAt      DateTime  @default(now())

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  businessCard BusinessCard? @relation(fields: [businessCardId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@index([organizationId])
  @@index([businessCardId])
  @@map("media")
}

model AnalyticsEvent {
  id             String             @id @default(cuid())
  businessCardId String
  eventType      AnalyticsEventType
  countryCode    String?
  referrerDomain String?
  createdAt      DateTime           @default(now())

  businessCard BusinessCard @relation(fields: [businessCardId], references: [id], onDelete: Cascade)

  @@index([businessCardId, eventType, createdAt])
  @@index([createdAt])
  @@map("analytics_events")
}

model SlugRedirect {
  id             String   @id @default(cuid())
  businessCardId String
  oldSlug        String   @unique
  newSlug        String
  createdAt      DateTime @default(now())

  businessCard BusinessCard @relation(fields: [businessCardId], references: [id], onDelete: Cascade)

  @@index([businessCardId])
  @@map("slug_redirects")
}
