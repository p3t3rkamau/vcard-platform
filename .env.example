# Public application URL (safe to expose)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Neon PostgreSQL
# Pooled URL for normal application queries
DATABASE_URL=""

# Direct/unpooled URL for migrations and administrative operations
DIRECT_URL=""

# Auth.js
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Vercel Blob (server-side only)
BLOB_READ_WRITE_TOKEN=""

# SMTP email delivery (required for registration verification and password resets)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="vCard Platform <no-reply@example.com>"

# Comma-separated email addresses allowed to access platform administration
ADMIN_EMAILS=""

# Development only: allows local sign-in before SMTP is configured (never enable in production)
ALLOW_UNVERIFIED_LOGIN="false"
