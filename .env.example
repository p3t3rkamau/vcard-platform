# Public application URL (safe to expose). Local development only:
# do NOT set this on Vercel, where the production/preview URL is detected automatically.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Neon PostgreSQL
# Pooled URL for normal application queries
DATABASE_URL=""

# Direct/unpooled URL for migrations and administrative operations
DIRECT_URL=""


# Auth.js
AUTH_SECRET=""
# Auth.js v5 on Vercel infers the host from request headers; do not set AUTH_URL there.

# Vercel Blob (server-side only). Use the token of a *Public* Blob store: card images are public.
# Vercel names this "<PREFIX>_READ_WRITE_TOKEN". Accepted, first one set wins:
# VC_READ_WRITE_TOKEN, VCARD_READ_WRITE_TOKEN, VC_BLOB_READ_WRITE_TOKEN, VCARD_BLOB_READ_WRITE_TOKEN, BLOB_READ_WRITE_TOKEN.
VC_READ_WRITE_TOKEN=""

# SMTP email delivery (required for registration verification and password resets)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="vCard Platform <no-reply@example.com>"

# Comma-separated email addresses allowed to access platform administration
ADMIN_EMAILS=""

# Development only: allows local sign-in before SMTP is configured (never enable in production)
ALLOW_UNVERIFIED_LOGIN="false"
